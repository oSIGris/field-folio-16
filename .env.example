# ─────────────────────────────────────────────────────────────
# Variables de entorno — Cooperativa ERP
# Copia este archivo como `.env` y rellena con los valores de TU
# proyecto de Supabase (Dashboard → Project Settings → API).
#
# NOTA: este proyecto usa tu PROPIO Supabase, no Lovable Cloud.
# Solo se exponen al navegador las variables con prefijo VITE_.
# La service role key NUNCA debe ir aquí ni subirse al repo: se
# configura como secreto del entorno servidor.
# ─────────────────────────────────────────────────────────────

# --- Cliente (navegador) — claves públicas ---
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="tu-anon-publishable-key"
VITE_SUPABASE_PROJECT_ID="tu-project-ref"

# --- Servidor (SSR / server functions) ---
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_PUBLISHABLE_KEY="tu-anon-publishable-key"

# Service role key — SOLO en entorno servidor seguro. NO subir al repo.
# SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"